{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",          // ✅ safer for Node backend
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "node",    // ✅ use node resolution for backend
    "isolatedModules": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "outDir": "dist",              // ✅ compiled files go here
    "noEmit": false,               // ✅ allow TypeScript to output .js files
    "esModuleInterop": true,       // ✅ smoother interop with common libs
    "forceConsistentCasingInFileNames": true
  },
  "include": ["server.ts", "src"], // ✅ compile backend + frontend
  "exclude": ["node_modules"]
}